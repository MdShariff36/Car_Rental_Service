# ═══════════════════════════════════════════════════════════════
# AUTO PRIME CAR RENTAL - BACKEND ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# SERVER CONFIGURATION
# Port number for the backend server (must be 8080 to match frontend)
PORT=8080

# DATABASE CONFIGURATION (MySQL)
# Host where MySQL server is running
DB_HOST=localhost

# MySQL default port
DB_PORT=3306

# Database name - will be created automatically if it doesn't exist
DB_NAME=autoprime_db

# MySQL username (use 'root' for local development or create a dedicated user)
DB_USER=root

# MySQL password (CHANGE THIS to your MySQL root password)
DB_PASSWORD=Muhamedshariff

# JWT AUTHENTICATION
# Secret key for JWT token generation (CHANGE THIS to a random secure string)
JWT_SECRET=your_jwt_secret_key_change_this_in_production_12345

# JWT token expiration time
JWT_EXPIRES_IN=7d

# DEFAULT ADMIN USER
# Email for the default admin account
ADMIN_EMAIL=admin@autoprime.com

# Password for the default admin account (will be hashed)
ADMIN_PASSWORD=Admin@123456

# EMAIL CONFIGURATION (for notifications and password reset)
# Gmail address for sending emails
EMAIL_USER=your_email@gmail.com

# Gmail app password (not your regular password - generate from Google Account settings)
EMAIL_PASS=your_app_password

# Email sender name and address
EMAIL_FROM=Auto Prime <no-reply@autoprime.com>

# ENVIRONMENT
# Set to 'production' when deploying to live server
NODE_ENV=development